// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RichMenuStatus {
  DRAFT
  DEPLOYED
}

enum DeployStatus {
  PENDING
  SUCCESS
  FAILED
}

enum LineAccountRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                  String                  @id @default(cuid())
  ldapUsername        String?                 @unique
  email               String?                 @unique
  name                String?
  department          String?
  image               String?                 @db.Text
  emailVerified       DateTime?
  passwordHash        String?
  isApproved          Boolean                 @default(false)
  isSystemAdmin       Boolean                 @default(false)

  // LINE Login binding
  lineUserId          String?                 @unique
  lineDisplayName     String?
  linePictureUrl      String?                 @db.Text

  lineAccountAssignments     LineAccountAssignment[]
  requestedLineAccountRequests LineAccountRequest[] @relation("LineAccountRequestRequestedBy")
  reviewedLineAccountRequests  LineAccountRequest[] @relation("LineAccountRequestReviewedBy")
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
}

model LineAccount {
  id                  String                  @id @default(cuid())
  name                String
  pictureUrl          String?                 @db.Text
  channelId           String                  @unique
  channelSecret       String                  @db.Text
  accessToken         String                  @db.Text
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  assignments         LineAccountAssignment[]
  richMenus           RichMenu[]
  clickEvents         ClickEvent[]
  lineAccountRequests LineAccountRequest[]
}

model LineAccountRequest {
  id              String                   @id @default(cuid())
  name            String
  channelId       String
  channelSecret   String                   @db.Text
  accessToken     String                   @db.Text
  status          LineAccountRequestStatus @default(PENDING)
  requestedById   String
  reviewedById    String?
  rejectionReason String?                  @db.Text
  reviewedAt      DateTime?
  lineAccountId   String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  requestedBy User         @relation("LineAccountRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?        @relation("LineAccountRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  lineAccount LineAccount? @relation(fields: [lineAccountId], references: [id], onDelete: SetNull)

  @@index([requestedById, status])
  @@index([status, createdAt])
  @@index([channelId, status])
}

model LineAccountAssignment {
  id            String      @id @default(cuid())
  userId        String
  lineAccountId String
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lineAccount   LineAccount @relation(fields: [lineAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, lineAccountId])
  @@index([lineAccountId])
}

model RichMenu {
  id             String          @id @default(cuid())
  lineAccountId  String
  name           String
  description    String?
  width          Int
  height         Int
  imageUrl       String         @db.Text
  chatBarText    String         @default("")
  lineRichMenuId String?        @unique
  status         RichMenuStatus @default(DRAFT)
  isDefault      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lineAccount LineAccount   @relation(fields: [lineAccountId], references: [id])
  areas       RichMenuArea[]
  deployLogs  DeployLog[]
  clickEvents ClickEvent[]

  @@index([lineAccountId])
}

model RichMenuArea {
  id         String   @id @default(cuid())
  richMenuId String
  x          Int
  y          Int
  width      Int
  height     Int
  order      Int
  actionType String
  action     Json

  richMenu RichMenu @relation(fields: [richMenuId], references: [id])

  @@index([richMenuId])
}

model DeployLog {
  id         String       @id @default(cuid())
  richMenuId String
  status     DeployStatus
  message    String?
  deployedAt DateTime     @default(now())

  richMenu RichMenu @relation(fields: [richMenuId], references: [id])

  @@index([richMenuId, deployedAt])
}

model ClickEvent {
  id           String   @id @default(cuid())
  lineAccountId String
  richMenuId    String
  areaIndex     Int
  lineUserId    String
  createdAt     DateTime @default(now())

  lineAccount LineAccount @relation(fields: [lineAccountId], references: [id])
  richMenu    RichMenu    @relation(fields: [richMenuId], references: [id])

  @@index([lineAccountId, richMenuId, createdAt])
}
