# ── Database ──────────────────────────────────────────────
# mysql://user:password@host:port/database
# SSL: ใส่ ?sslaccept=strict ใน URL หรือตั้ง DATABASE_SSL=true
DATABASE_URL="mysql://root:password@127.0.0.1:3306/rpp_richmenu"
# DATABASE_SSL=true

# ── NextAuth (required — no fallback) ─────────────────────
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Optional: dedicated key for encrypting LINE channelSecret/accessToken at rest.
# If unset, NEXTAUTH_SECRET is used. Existing plaintext values still decrypt.
# CREDENTIALS_ENCRYPTION_KEY="another-long-random-string"

# ── LDAP (required for login) ─────────────────────────────
LDAP_URL="ldap://ldap.example.com:389"
LDAP_BASE_DN="DC=example,DC=com"
LDAP_BIND_DN="CN=svc-rpp,OU=Service Accounts,DC=example,DC=com"
LDAP_BIND_PASSWORD="bind-password"

# Optional LDAP tuning
# LDAP_SEARCH_FILTER="(sAMAccountName={{username}})"
# LDAP_TIMEOUT=5000
# LDAP_CONNECT_TIMEOUT=5000
# LDAP_IDLE_TIMEOUT=10000
# LDAP_RECONNECT=true
# LDAP_USER_OU="rpp-user"
# LDAP_USER_DOMAIN="example.local"

# ── LINE Login (optional — profile page account linking) ──
# LINE_LOGIN_CHANNEL_ID=
# LINE_LOGIN_CHANNEL_SECRET=
# LINE_LOGIN_CALLBACK_URL="http://localhost:3000/api/line/connect/callback"
