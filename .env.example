DATABASE_URL="mysql://root:password@127.0.0.1:3306/rpp_richmenu"

# App listen port (Next.js / PM2). Default 3007.
PORT=3007

NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Must match the URL users open (include port if not 80/443 behind proxy)
NEXTAUTH_URL="http://localhost:3007"

LDAP_URL="ldap://ldap.example.com:389"
LDAP_BASE_DN="DC=example,DC=com"
LDAP_BIND_DN="CN=svc-rpp,OU=Service Accounts,DC=example,DC=com"
LDAP_BIND_PASSWORD="bind-password"
# Optional — สมาชิก AD group นี้ login แล้วได้ isApproved + isSystemAdmin ทันที
# LDAP_ADMIN_GROUP_DN="CN=Domain Admins,CN=Users,DC=example,DC=com"

# Optional — LINE Login (profile page account linking)
LINE_LOGIN_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""
LINE_LOGIN_CALLBACK_URL="http://localhost:3007/api/line/connect/callback"
